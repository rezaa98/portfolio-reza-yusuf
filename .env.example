# Optional CMS. The portfolio and production build work without these values.
NEXT_PUBLIC_SANITY_PROJECT_ID=qh9tfzfg
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-11

# Required only for the live AI QA Agent.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_GEMINI_MODEL_DISPLAY=Google Gemini 2.5 Flash

# Required only for contact email delivery.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=Portfolio <onboarding@resend.dev>

# Optional observability integrations.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
NEXT_PUBLIC_GRAFANA_DASHBOARD_URL=
