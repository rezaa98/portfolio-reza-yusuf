{
  "openapi": "3.0.0",
  "info": {
    "title": "Portfolio API Documentation",
    "description": "Public endpoints for the portfolio. Requests use schema validation, bounded payloads, safe errors, origin checks, and rate limiting where applicable.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Local/Production Server"
    }
  ],
  "paths": {
    "/api/posts": {
      "get": {
        "summary": "Retrieve Blog Posts",
        "description": "Fetches a list of blog posts from the Sanity CMS backend, ordered by pinned status and publication date.",
        "tags": ["Blog"],
        "responses": {
          "200": {
            "description": "Successful response containing an array of posts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "_id": { "type": "string" },
                          "title": { "type": "string" },
                          "slug": { "type": "string" },
                          "publishedAt": { "type": "string", "format": "date-time" },
                          "excerpt": { "type": "string" },
                          "isPinned": { "type": "boolean" },
                          "categories": { "type": "array", "items": { "type": "string" } },
                          "mainImage": { "type": "string" },
                          "firstBodyImage": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Sanity is configured but temporarily unavailable"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "AI Chat Assistant for Playwright",
        "description": "An endpoint that leverages Google Gemini AI to generate Playwright E2E test scripts based on user prompts. Returns a text stream response.",
        "tags": ["AI Tools"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "messages": {
                    "type": "array",
                    "description": "Array of conversation messages",
                    "items": {
                      "type": "object",
                      "required": ["role"],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": ["user", "assistant"]
                        },
                        "content": {
                          "type": "string",
                          "maxLength": 4000
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful text stream response containing the AI output",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or message schema"
          },
          "403": { "description": "Browser origin is not allowed" },
          "413": { "description": "Request payload is too large" },
          "429": { "description": "Rate limit exceeded" },
          "502": { "description": "AI provider is temporarily unavailable" },
          "503": { "description": "AI integration is not configured" }
        }
      }
    },
    "/api/contact": {
      "post": {
        "summary": "Send a portfolio contact message",
        "description": "Validates and delivers a contact message through Resend. A honeypot and per-IP rate limit reduce automated abuse.",
        "tags": ["Contact"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "message"],
                "properties": {
                  "name": { "type": "string", "minLength": 2, "maxLength": 100 },
                  "email": { "type": "string", "format": "email", "maxLength": 254 },
                  "message": { "type": "string", "minLength": 10, "maxLength": 5000 },
                  "website": { "type": "string", "maxLength": 0, "description": "Anti-bot honeypot; leave empty." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Message delivered" },
          "400": { "description": "Invalid contact details" },
          "403": { "description": "Browser origin is not allowed" },
          "413": { "description": "Request payload is too large" },
          "429": { "description": "Rate limit exceeded" },
          "502": { "description": "Email provider could not deliver the message" },
          "503": { "description": "Email delivery is not configured" }
        }
      }
    }
  }
}
