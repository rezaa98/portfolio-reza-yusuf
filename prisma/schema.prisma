generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  role          String
  bio           String
  location      String
  email         String
  phone         String
  linkedinUrl   String?
  credlyUrl     String?
  githubUrl     String?
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  experiences   Experience[]
  projects      Project[]
  certifications Certification[]
}

model Experience {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @db.Uuid
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String
  role        String
  type        String   // "fulltime", "internship", "contract"
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean  @default(false)
  description String   @db.Text
  techTags    String[]
  order       Int      @default(0)
}

model Project {
  id           String         @id @default(uuid()) @db.Uuid
  profileId    String         @db.Uuid
  profile      Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  slug         String         @unique
  shortDesc    String
  fullDesc     String         @db.Text
  category     String         // "web", "mobile", "api", "automation", "ai"
  status       String         // "completed", "in_progress", "archived"
  techStack    String[]
  thumbnailUrl String?
  demoUrl      String?
  githubUrl    String?
  year         Int
  isFeatured   Boolean        @default(false)
  order        Int            @default(0)
  images       ProjectImage[]
}

model ProjectImage {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  order     Int     @default(0)
}

model Skill {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  category    String  // "automation", "languages", "tools", "cloud_ai"
  iconUrl     String?
  proficiency Int     // 1-100
  order       Int     @default(0)
}

model Certification {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @db.Uuid
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  issuer       String   // "Cisco", "Google Cloud", "Microsoft", "Dicoding"
  badgeUrl     String?
  credlyUrl    String?
  level        String?
  typeCategory String?
  issuedAt     DateTime
  expiresAt    DateTime?
  skills       String[]
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("unread") // "unread", "read", "replied"
  createdAt DateTime @default(now())
}
